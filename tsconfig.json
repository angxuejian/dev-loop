{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": []
  },
  "references": [],
  "include": [
    "backend/**/*.js",
    "backend/**/*.ts",
    "frontend/**/*.js",
    "frontend/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts",
    "features/**/*.js",
    "features/**/*.ts"
  ],
  "exclude": ["node_modules", "frontend/card-draw/.build"]
}
