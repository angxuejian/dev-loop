{
  "name": "dev-loop",
  "version": "1.0.0",
  "description": "An AI-powered development loop that plans, implements, tests, reviews, and iteratively fixes code until it's ready for human approval.",
  "type": "module",
  "scripts": {
    "lint": "eslint \"{backend,frontend,scripts,features}/**/*.{js,ts}\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"{backend,frontend,scripts,features}/**/*.{js,ts,json,md}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --project tsconfig.json",
    "card-draw": "tsc --project frontend/card-draw/tsconfig.json && python3 -m http.server 8000 --bind 127.0.0.1 --directory frontend/card-draw",
    "test:card-draw": "tsc --project frontend/card-draw/tsconfig.json && node --test frontend/card-draw/draw.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node --test scripts/tests/build-pages.test.mjs"
  },
  "author": "angxuejian",
  "keywords": [
    "dev-loop",
    "ai",
    "agent"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/angxuejian/dev-loop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0"
  }
}
